generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  DELETED
}

enum VisibilityStatus {
  VISIBLE
  HIDDEN
  ARCHIVED
}

enum YesNoStatus {
  YES
  NO
}

enum UserLevel {
  OWNER
  ADMIN
  AFFILIATE
  OPERATOR
  CUSTOMER
}

enum DocumentType {
  CPF
  CNPJ
  RG
  OTHER
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
  TABLE
  OTHER
}

enum DeliveryFeeType {
  FIXED
  BY_DISTANCE
  BY_CEP
  MANUAL
}

enum PaymentMethod {
  MONEY
  DEBIT_CARD
  CREDIT_CARD
  FOOD_CARD
  PIX
  ONLINE
  OTHER
}

enum PaymentGateway {
  MERCADO_PAGO
  PAGSEGURO
  GETNET
  PIX_MANUAL
  OTHER
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
  REFUNDED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELED
  SUSPENDED
}

enum SubscriptionMode {
  TRIAL
  PAID
  VOUCHER
  MANUAL
}

enum VoucherStatus {
  UNUSED
  USED
  EXPIRED
  CANCELED
}

enum BannerScope {
  STORE
  MARKETPLACE
}

enum MediaType {
  PRODUCT
  CATEGORY
  STORE
  BANNER
  OTHER
}

enum DomainType {
  STORE
  MARKETPLACE
  CUSTOM
}

enum ScheduleAction {
  OPEN
  CLOSE
}

// ============================================================
// MODULE: IDENTITY_ACCESS
// ============================================================
model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String?      @map("name") @db.VarChar(255)
  email        String?      @unique @db.VarChar(255)
  passwordHash String?      @map("password_hash") @db.VarChar(255)
  level        UserLevel    @default(OPERATOR)
  operation    YesNoStatus  @default(NO) @map("operation")
  status       EntityStatus @default(ACTIVE)
  recoverKey   String?      @map("recover_key") @db.VarChar(255)
  keepAlive    String?      @map("keepalive") @db.VarChar(255)
  commission   String?      @map("commission") @db.VarChar(255)
  lastLoginAt  DateTime?    @map("last_login")
  createdAt    DateTime?    @map("created_at")
  updatedAt    DateTime?    @updatedAt @map("last_modified")
  deletedAt    DateTime?    @map("deleted_at")

  profile        UserData?
  address        Address?
  establishments Establishment[]
  logs           Log[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model UserData {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @unique @map("user_id") @db.Uuid
  birthDate     String?       @map("birth_date") @db.VarChar(255)
  documentType  DocumentType? @map("document_type")
  document      String?       @map("document") @db.VarChar(255)
  stateLegacyId String?       @map("state_id") @db.VarChar(255)
  cityLegacyId  String?       @map("city_id") @db.VarChar(255)
  phone         String?       @map("phone") @db.VarChar(255)
  commission    String?       @map("commission") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([document])
  @@map("users_data")
}

// ============================================================
// MODULE: GEO
// ============================================================
model State {
  id   String  @id @default(uuid()) @db.Uuid
  name String? @map("name") @db.VarChar(75)
  uf   String? @db.VarChar(5)

  cities    City[]
  addresses Address[]

  @@unique([uf])
  @@map("states")
}

model City {
  id        String  @id @default(uuid()) @db.Uuid
  name      String? @map("name") @db.VarChar(120)
  stateId   String? @map("state_id") @db.Uuid
  subdomain String? @map("subdomain") @db.VarChar(255)

  state        State?              @relation(fields: [stateId], references: [id], onDelete: SetNull)
  marketplaces MarketplaceBanner[]
  customers    Customer[]
  addresses    Address[]

  @@index([stateId])
  @@index([subdomain])
  @@map("cities")
}

// ============================================================
// MODULE: ESTABLISHMENTS_CORE
// ============================================================
model Segment {
  id        String  @id @default(uuid()) @db.Uuid
  icon      String? @map("icon") @db.VarChar(255)
  name      String? @map("name") @db.VarChar(75)
  ageRating String? @map("age_rating") @db.VarChar(255)

  establishments Establishment[]

  @@map("segments")
}

model Establishment {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String?      @map("user_id") @db.Uuid
  segmentId        String?      @map("segment_id") @db.Uuid
  licenseId        Int          @default(0) @map("license_id")
  oneSignalId      String?      @map("onesignal_id") @db.VarChar(150)
  affiliate        String?      @map("affiliate") @db.VarChar(255)
  name             String?      @map("name") @db.VarChar(255)
  description      String?      @map("description") @db.Text
  subdomain        String?      @unique @map("subdomain") @db.VarChar(255)
  profileImage     String?      @map("profile_image") @db.VarChar(255)
  coverImage       String?      @map("cover_image") @db.VarChar(255)
  themeColor       String?      @map("theme_color") @db.VarChar(255)
  email            String?      @db.VarChar(255)
  status           EntityStatus @default(ACTIVE)
  forcedStatus     String?      @map("status_force") @db.VarChar(255)
  operationStatus  String?      @map("operation_status") @db.VarChar(255)
  expirationStatus String?      @default("1") @map("expiration_status") @db.VarChar(255)
  excluded         String?      @db.VarChar(255)
  excludedAt       DateTime?    @map("excluded_date")
  createdAt        DateTime?    @map("created_at")
  updatedAt        DateTime?    @updatedAt @map("last_modified")
  lastLoginAt      DateTime?    @map("last_login")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  segment Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  address     Address?
  contact     Contact?
  setting     Setting?
  flag        Flag?
  integration Integration?
  responsible Responsible?

  schedules     Schedule[]
  subscriptions Subscription[]
  banners       Banner[]
  categories    Category[]
  customers     Customer[]
  coupons       Coupon[]
  freights      Freight[]
  logs          Log[]
  media         Media[]
  orders        Order[]
  products      Product[]
  validities    Validity[]
  payments      Payment[]

  @@index([userId])
  @@index([segmentId])
  @@index([status])
  @@index([subdomain])
  @@map("establishments")
}

// ============================================================
// MODULE: SHARED_ADDRESSES
// Reutilizável por Establishment, User e Customer.
// ============================================================
model Address {
  id              String    @id @default(uuid()) @db.Uuid
  establishmentId String?   @unique @map("establishment_id") @db.Uuid
  userId          String?   @unique @map("user_id") @db.Uuid
  customerId      String?   @unique @map("customer_id") @db.Uuid
  stateId         String?   @map("state_id") @db.Uuid
  cityId          String?   @map("city_id") @db.Uuid
  stateLegacy     String?   @map("state_legacy") @db.VarChar(255)
  cityLegacy      String?   @map("city_legacy") @db.VarChar(255)
  zipCode         String?   @map("zip_code") @db.VarChar(255)
  addressNumber   String?   @map("address_number") @db.VarChar(255)
  neighborhood    String?   @map("neighborhood") @db.VarChar(255)
  street          String?   @map("street") @db.VarChar(255)
  complement      String?   @map("complement") @db.VarChar(255)
  reference       String?   @map("reference") @db.VarChar(255)
  createdAt       DateTime? @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  state         State?         @relation(fields: [stateId], references: [id], onDelete: SetNull)
  city          City?          @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([establishmentId])
  @@index([userId])
  @@index([customerId])
  @@index([stateId])
  @@index([cityId])
  @@map("addresses")
}

model Contact {
  id              String  @id @default(uuid()) @db.Uuid
  establishmentId String  @unique @map("establishment_id") @db.Uuid
  whatsapp        String? @map("whatsapp") @db.VarChar(255)
  email           String? @map("email") @db.VarChar(255)
  instagram       String? @map("instagram") @db.VarChar(255)
  facebook        String? @map("facebook") @db.VarChar(255)
  youtube         String? @map("youtube") @db.VarChar(255)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@map("establishment_contact")
}

model Setting {
  id                      String           @id @default(uuid()) @db.Uuid
  establishmentId         String           @unique @map("establishment_id") @db.Uuid
  minimumOrder            Decimal?         @map("minimum_order") @db.Decimal(10, 2)
  acceptsMoney            YesNoStatus?     @map("payment_cash")
  acceptsDebitCard        YesNoStatus?     @map("payment_debit_card")
  debitCardBrands         String?          @map("payment_debit_card_brands") @db.VarChar(255)
  acceptsCreditCard       YesNoStatus?     @map("payment_credit_card")
  creditCardBrands        String?          @map("payment_credit_card_brands") @db.VarChar(255)
  acceptsFoodCard         YesNoStatus?     @map("payment_food_card")
  foodCardBrands          String?          @map("payment_food_card_brands") @db.VarChar(255)
  acceptsOtherPayment     YesNoStatus?     @map("payment_other")
  otherPaymentDescription String?          @map("payment_other_description") @db.VarChar(255)
  acceptsPix              YesNoStatus?     @map("payment_pix")
  pixType                 String?          @map("pix_type") @db.VarChar(255)
  pixKey                  String?          @map("pix_key") @db.VarChar(99)
  pixBeneficiary          String?          @map("pix_beneficiary") @db.VarChar(25)
  establishmentPixData    String?          @map("establishment_pix_data") @db.Text
  businessHoursText       String?          @map("business_hours_text") @db.Text
  businessHoursJson       String?          @map("business_hours_json") @db.Text
  allowPickup             YesNoStatus?     @map("pickup_enabled_legacy")
  allowDelivery           YesNoStatus?     @map("delivery_enabled_legacy")
  deliveryType            DeliveryFeeType? @map("delivery_fee_type")
  deliveryValue           Decimal?         @map("delivery_fee_value") @db.Decimal(10, 2)
  productLimit            String?          @map("product_limit") @db.VarChar(255)
  displayMode             String?          @default("1") @map("display_mode") @db.VarChar(11)
  deliveryName            String?          @default("Delivery") @map("delivery_name") @db.VarChar(255)
  pickupName              String?          @default("Retirada no Balcão") @map("pickup_name") @db.VarChar(255)
  tableName               String?          @default("Mesa") @map("table_name") @db.VarChar(255)
  deliveryEnabled         YesNoStatus      @default(YES) @map("delivery")
  pickupEnabled           YesNoStatus      @default(YES) @map("pickup_enabled")
  tableEnabled            YesNoStatus      @default(YES) @map("table_enabled")
  otherEnabled            YesNoStatus      @default(NO) @map("other_enabled")
  otherName               String?          @map("other_name") @db.VarChar(255)
  calculateShipping       YesNoStatus      @default(NO) @map("calculate_shipping")
  shippingType            DeliveryFeeType? @map("shipping_type")
  shippingCompany         String?          @map("shipping_company") @db.VarChar(150)
  shippingPassword        String?          @map("shipping_password") @db.VarChar(50)
  validity                Int              @default(0) @map("validity")
  triggerCount            Int              @default(0) @map("trigger_count")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@map("establishment_settings")
}

model Flag {
  id                 String       @id @default(uuid()) @db.Uuid
  establishmentId    String       @unique @map("establishment_id") @db.Uuid
  marketplaceFeature YesNoStatus? @map("marketplace_feature")
  variationFeature   YesNoStatus? @map("variation_feature")
  bannerFeature      YesNoStatus? @map("banner_feature")
  triggerFeature     YesNoStatus  @default(YES) @map("trigger_feature")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@map("establishment_flags")
}

model Integration {
  id                    String      @id @default(uuid()) @db.Uuid
  establishmentId       String      @unique @map("establishment_id") @db.Uuid
  analyticsCode         String?     @map("analytics_code") @db.VarChar(255)
  pixelCode             String?     @map("pixel_code") @db.VarChar(255)
  customHtml            String?     @map("html") @db.Text
  token                 String?     @db.VarChar(250)
  accessToken           String?     @map("access_token") @db.VarChar(250)
  mercadoPagoEnabled    YesNoStatus @default(NO) @map("mercado_pago_payment")
  mercadoPagoSandbox    Boolean     @default(false) @map("mercado_pago_sandbox")
  mercadoPagoPublicKey  String?     @map("mercado_pago_public_key") @db.VarChar(200)
  mercadoPagoSecretKey  String?     @map("mercado_pago_secret_key") @db.VarChar(200)
  pagSeguroEnabled      YesNoStatus @default(NO) @map("pagseguro_payment")
  pagSeguroSandbox      Boolean     @default(false) @map("pagseguro_sandbox")
  pagSeguroEmail        String?     @map("pagseguro_email") @db.VarChar(200)
  pagSeguroToken        String?     @map("pagseguro_token") @db.VarChar(200)
  mercadoPagoPixEnabled YesNoStatus @default(NO) @map("mercado_pago_pix_payment")
  mercadoPagoPixToken   String?     @map("mercado_pago_pix_token") @db.VarChar(100)
  getnetEnabled         YesNoStatus @default(NO) @map("getnet_payment")
  getnetSandbox         Boolean     @default(false) @map("getnet_sandbox")
  getnetClientId        String?     @map("getnet_client_id") @db.VarChar(200)
  getnetClientSecret    String?     @map("getnet_client_secret") @db.VarChar(200)
  getnetSellerId        String?     @map("getnet_seller_id") @db.VarChar(200)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@map("establishment_integrations")
}

model Responsible {
  id              String        @id @default(uuid()) @db.Uuid
  establishmentId String        @unique @map("establishment_id") @db.Uuid
  name            String?       @map("responsible_name") @db.VarChar(255)
  birthDate       String?       @map("responsible_birth_date") @db.VarChar(255)
  documentType    DocumentType? @map("responsible_document_type")
  document        String?       @map("responsible_document") @db.VarChar(255)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@map("establishment_responsibles")
}

model Schedule {
  id              String          @id @default(uuid()) @db.Uuid
  establishmentId String?         @map("establishment_id") @db.Uuid
  sunday          Boolean?        @map("sun")
  monday          Boolean?        @map("mon")
  tuesday         Boolean?        @map("tue")
  wednesday       Boolean?        @map("wed")
  thursday        Boolean?        @map("thu")
  friday          Boolean?        @map("fri")
  saturday        Boolean?        @map("sat")
  time            String?         @map("time") @db.VarChar(255)
  action          ScheduleAction? @map("action")

  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@map("schedules")
}

// ============================================================
// MODULE: CATALOG
// ============================================================
model Category {
  id              String           @id @default(uuid()) @db.Uuid
  establishmentId String?          @map("establishment_id") @db.Uuid
  parentId        String?          @map("parent_id") @db.Uuid
  order           Int              @map("order")
  name            String?          @map("name") @db.VarChar(255)
  slug            String?          @map("slug") @db.VarChar(255)
  visible         VisibilityStatus @default(VISIBLE)
  status          EntityStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime?        @map("last_modified")
  deletedAt       DateTime?        @map("deleted_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  establishment Establishment?    @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  products      ProductCategory[]

  @@index([establishmentId])
  @@index([status])
  @@map("categories")
}

model Product {
  id               String            @id @default(uuid()) @db.Uuid
  establishmentId  String?           @map("establishment_id") @db.Uuid
  featured         YesNoStatus?      @map("featured")
  reference        String?           @map("ref") @db.VarChar(255)
  pdvCode          Int?              @map("pdv_code")
  points           Float             @default(0) @map("points")
  allowExchange    Boolean           @default(false) @map("allow_exchange")
  itemPoints       Int               @default(0) @map("item_points")
  name             String?           @map("name") @db.VarChar(255)
  videoLink        String?           @map("video_link") @db.VarChar(255)
  description      String?           @map("description") @db.Text
  price            Decimal?          @map("value") @db.Decimal(10, 2)
  offer            YesNoStatus?      @map("offer")
  promotionalPrice Decimal?          @map("promotional_value") @db.Decimal(10, 2)
  variationJson    String?           @map("variation_json") @db.Text
  visible          VisibilityStatus? @map("visible")
  status           EntityStatus      @default(ACTIVE)
  orderStatus      String?           @default("1") @map("public_status") @db.VarChar(2)
  integrated       String?           @map("integrated") @db.VarChar(255)
  shippingWeight   Float?            @map("shipping_weight")
  shippingHeight   Float?            @map("shipping_height")
  shippingWidth    Float?            @map("shipping_width")
  shippingLength   Float?            @map("shipping_length")
  shippingDiameter Float?            @map("shipping_diameter")
  stockEnabled     YesNoStatus       @default(YES) @map("stock_enabled")
  position         String?           @default("0") @map("position") @db.VarChar(9)
  createdAt        DateTime?         @map("created_at")
  updatedAt        DateTime?         @updatedAt @map("last_modified")

  establishment Establishment?    @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  categories    ProductCategory[]
  medias        Media[]
  validities    Validity[]

  @@index([establishmentId])
  @@index([status])
  @@index([name])
  @@map("products")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
  @@map("product_categories")
}

// ============================================================
// MODULE: MARKETING
// ============================================================
model Banner {
  id              String       @id @default(uuid()) @db.Uuid
  establishmentId String?      @map("establishment_id") @db.Uuid
  title           String?      @map("title") @db.VarChar(255)
  desktopImage    String?      @map("desktop_image") @db.VarChar(255)
  mobileImage     String?      @map("mobile_image") @db.VarChar(255)
  videoLink       String?      @map("video_link") @db.VarChar(255)
  link            String?      @db.VarChar(255)
  status          EntityStatus @default(ACTIVE)
  createdAt       DateTime?    @map("created_at")
  updatedAt       DateTime?    @updatedAt @map("last_modified")

  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@index([status])
  @@map("banners")
}

model MarketplaceBanner {
  id              String       @id @default(uuid()) @db.Uuid
  establishmentId String?      @map("establishment_id") @db.Uuid
  cityId          String?      @map("city_id") @db.Uuid
  title           String?      @map("title") @db.VarChar(255)
  desktopImage    String?      @map("desktop_image") @db.VarChar(255)
  mobileImage     String?      @map("mobile_image") @db.VarChar(255)
  videoLink       String?      @map("video_link") @db.VarChar(255)
  link            String?      @db.VarChar(255)
  status          EntityStatus @default(ACTIVE)
  createdAt       DateTime?    @map("created_at")
  updatedAt       DateTime?    @updatedAt @map("last_modified")

  city City? @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([establishmentId])
  @@index([cityId])
  @@index([status])
  @@map("marketplace_banners")
}

// ============================================================
// MODULE: CUSTOMERS
// ============================================================
model Customer {
  id               String      @id @default(uuid()) @db.Uuid
  establishmentId  String?     @map("establishment_id") @db.Uuid
  cityId           String?     @map("city_id") @db.Uuid
  greetingCount    Int         @default(0) @map("greeting_count")
  lastMessage      String?     @map("last_message") @db.Text
  name             String?     @map("name") @db.VarChar(150)
  timestamp        String?     @db.VarChar(255)
  triggerStatus    YesNoStatus @default(YES) @map("sts_disparador")
  includedAt       DateTime?   @default(now()) @map("datadeinclusao")
  whatsapp         String?     @db.VarChar(15)
  password         String?     @map("shipping_password") @db.VarChar(35)
  pointsQuantity   Float       @default(0) @map("qtdpontos")
  pointsOperations String?     @map("pontos_op") @db.Text
  ordersQuantity   Int         @default(0) @map("qtdpedidos")
  active           Boolean?    @map("active")
  zipCode          String?     @map("cep") @db.VarChar(15)
  street           String?     @map("rua") @db.VarChar(250)
  number           String?     @map("numero") @db.VarChar(15)
  neighborhood     String?     @map("bairro") @db.VarChar(150)
  stateLegacyId    Int?        @map("uf")
  complement       String?     @map("complemento") @db.VarChar(250)
  reference        String?     @map("payment_reference") @db.VarChar(250)
  p256dh           String?     @db.VarChar(350)
  auth             String?     @db.VarChar(250)
  endpoint         String?     @db.Text

  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  city          City?          @relation(fields: [cityId], references: [id], onDelete: SetNull)
  addresses     Address[]

  @@index([establishmentId])
  @@index([cityId])
  @@index([whatsapp])
  @@map("customers")
}

// ============================================================
// MODULE: MARKETING
// ============================================================
model Coupon {
  id                 String    @id @default(uuid()) @db.Uuid
  establishmentId    String?   @map("establishment_id") @db.Uuid
  name               String?   @map("name") @db.VarChar(255)
  description        String?   @map("description") @db.Text
  code               String?   @map("code") @db.VarChar(255)
  type               String?   @map("type") @db.VarChar(255)
  discountPercentage String?   @map("desconto_porcentagem") @db.VarChar(255)
  fixedDiscount      Decimal?  @map("desconto_fixo") @db.Decimal(10, 2)
  maxValue           Decimal?  @map("valor_maximo") @db.Decimal(10, 2)
  quantity           String?   @map("quantidade") @db.VarChar(255)
  validUntil         DateTime? @map("validity")

  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, code])
  @@index([establishmentId])
  @@map("coupons")
}

// ============================================================
// MODULE: ESTABLISHMENTS_FULFILLMENT
// ============================================================
model Freight {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String?  @map("establishment_id") @db.Uuid
  name            String?  @map("name") @db.VarChar(255)
  value           Decimal? @map("value") @db.Decimal(10, 2)
  other           Boolean  @default(false) @map("other_enabled")

  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@map("freights")
}

// ============================================================
// MODULE: PRINTING
// ============================================================
model PrinterSession {
  id     String      @id @default(uuid()) @db.Uuid
  ide    String?     @db.VarChar(9)
  status YesNoStatus @default(NO)
  token  String?     @db.VarChar(255)

  @@map("impressao")
}

// ============================================================
// MODULE: MARKETING
// ============================================================
model Link {
  id   String  @id @default(uuid()) @db.Uuid
  url  String? @map("link") @db.VarChar(550)
  name String? @map("name") @db.VarChar(255)

  @@map("link")
}

// ============================================================
// MODULE: AUDIT
// ============================================================
model Log {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  establishmentId String?  @map("rel_lojas_id") @db.Uuid
  info            String?  @db.Text
  createdAt       DateTime @map("date_time")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([establishmentId])
  @@map("logs")
}

// ============================================================
// MODULE: CATALOG
// ============================================================
model Media {
  id              String     @id @default(uuid()) @db.Uuid
  type            MediaType? @map("type")
  establishmentId String?    @map("establishment_id") @db.Uuid
  productId       String?    @map("product_id") @db.Uuid
  url             String?    @db.VarChar(255)

  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  product       Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@index([productId])
  @@map("midia")
}

// ============================================================
// MODULE: ORDERS
// ============================================================
model Order {
  id               String          @id @default(uuid()) @db.Uuid
  licenseId        Int?            @map("license_id")
  segmentId        String?         @map("rel_segmentos_id") @db.Uuid
  establishmentId  String?         @map("establishment_id") @db.Uuid
  customerName     String?         @map("name") @db.VarChar(255)
  whatsapp         String?         @db.VarChar(255)
  deliveryMethod   DeliveryMethod? @map("delivery_method")
  stateLegacy      String?         @map("state_id") @db.VarChar(255)
  cityLegacy       String?         @map("city_id") @db.VarChar(255)
  zipCode          String?         @map("zip_code") @db.VarChar(255)
  addressNumber    String?         @map("address_number") @db.VarChar(255)
  neighborhood     String?         @map("neighborhood") @db.VarChar(255)
  street           String?         @map("street") @db.VarChar(255)
  complement       String?         @map("complement") @db.VarChar(255)
  reference        String?         @map("reference") @db.VarChar(255)
  paymentMethod    PaymentMethod?  @map("payment_method")
  paymentInfo      String?         @map("payment_info") @db.VarChar(255)
  receipt          String?         @map("receipt") @db.Text
  payloadJson      String?         @map("payload_json") @db.Text
  status           OrderStatus     @default(PENDING)
  orderedAt        DateTime?       @map("ordered_at")
  coupon           String?         @map("coupon") @db.VarChar(255)
  orderValue       Decimal?        @map("order_value") @db.Decimal(10, 2)
  fee              Float?          @map("fee")
  tableNumber      Int?            @map("table_enabled")
  publicStatus     String          @default("1") @map("public_status") @db.VarChar(2)
  integrated       Int?            @map("integrated")
  message          String?         @map("message") @db.VarChar(250)
  paymentLink      String?         @map("payment_link") @db.VarChar(400)
  paymentReference String?         @map("payment_reference") @db.VarChar(120)
  paidAt           DateTime?       @map("paid_at")
  paymentStatus    PaymentStatus?  @map("payment_status")
  paymentType      String?         @map("payment_type") @db.VarChar(25)
  paymentDetails   String?         @map("payment_details") @db.Text

  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@index([establishmentId])
  @@index([status])
  @@index([orderedAt])
  @@index([whatsapp])
  @@map("orders")
}

// ============================================================
// MODULE: BILLING
// ============================================================
model Payment {
  id              String         @id @default(uuid()) @db.Uuid
  establishmentId String         @map("establishment_id") @db.Uuid
  orderId         String         @map("order_id") @db.Uuid
  date            String         @map("date") @db.VarChar(200)
  time            String         @map("time") @db.VarChar(200)
  value           String         @map("value") @db.VarChar(200)
  gateway         PaymentGateway @map("gateway")
  code            String         @map("code") @db.VarChar(200)
  status          PaymentStatus  @default(PENDING)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Plan {
  id                 String            @id @default(uuid()) @db.Uuid
  highlighted        YesNoStatus?      @map("featured")
  name               String?           @map("name") @db.VarChar(255)
  description        String?           @map("description") @db.Text
  commission         String?           @map("commission") @db.VarChar(255)
  durationMonths     String?           @map("duration_months") @db.VarChar(255)
  durationDays       String?           @map("duration_days") @db.VarChar(255)
  totalValue         Decimal?          @map("total_value") @db.Decimal(10, 2)
  monthlyValue       Decimal?          @map("monthly_value") @db.Decimal(10, 2)
  link               String?           @db.VarChar(255)
  terms              String?           @map("terms") @db.Text
  marketplaceFeature YesNoStatus?      @map("marketplace_feature")
  variationFeature   YesNoStatus?      @map("variation_feature")
  bannerFeature      YesNoStatus?      @map("banner_feature")
  triggerFeature     YesNoStatus       @default(NO) @map("trigger_feature")
  visible            VisibilityStatus? @map("visible")
  status             EntityStatus      @default(ACTIVE)
  order              String?           @map("sort_order") @db.VarChar(255)
  productLimit       String?           @map("product_limit") @db.VarChar(255)

  subscriptions Subscription[]
  vouchers      Voucher[]

  @@index([status])
  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  planId                 String?            @map("plan_id") @db.Uuid
  establishmentId        String?            @map("establishment_id") @db.Uuid
  establishmentName      String?            @map("establishment_name") @db.VarChar(255)
  establishmentSubdomain String?            @map("establishment_subdomain") @db.VarChar(255)
  affiliate              String?            @map("affiliate") @db.VarChar(255)
  name                   String?            @map("name") @db.VarChar(255)
  description            String?            @map("description") @db.Text
  commission             String?            @map("commission") @db.VarChar(255)
  durationMonths         String?            @map("duration_months") @db.VarChar(255)
  durationDays           String?            @map("duration_days") @db.VarChar(255)
  totalValue             Decimal?           @map("total_value") @db.Decimal(10, 2)
  receivedValue          Decimal?           @map("received_value") @db.Decimal(10, 2)
  monthlyValue           Decimal?           @map("monthly_value") @db.Decimal(10, 2)
  terms                  String?            @map("terms") @db.Text
  triggerFeature         YesNoStatus        @default(NO) @map("trigger_feature")
  marketplaceFeature     YesNoStatus?       @map("marketplace_feature")
  variationFeature       YesNoStatus?       @map("variation_feature")
  bannerFeature          YesNoStatus?       @map("banner_feature")
  gatewayReference       String?            @map("gateway_ref") @db.VarChar(255)
  gatewayLink            String?            @map("gateway_link") @db.VarChar(255)
  gatewayTransaction     String?            @map("gateway_transaction") @db.VarChar(255)
  gatewayPayableAt       DateTime?          @map("gateway_payable") @db.Date
  gatewayExpirationAt    DateTime?          @map("gateway_expiration") @db.Date
  gatewayPayment         String?            @map("gateway_payment") @db.VarChar(255)
  mode                   SubscriptionMode?  @map("mode")
  voucherCode            String?            @map("voucher_code") @db.VarChar(255)
  status                 SubscriptionStatus @default(PENDING)
  used                   Boolean?           @map("used")
  expiresAt              DateTime?          @map("expiration") @db.Date
  createdAt              DateTime?          @map("created_at")
  excluded               String?            @db.VarChar(255)
  productLimit           String?            @map("product_limit") @db.VarChar(255)

  plan          Plan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  vouchers      Voucher[]

  @@index([planId])
  @@index([establishmentId])
  @@index([status])
  @@index([expiresAt])
  @@map("subscriptions")
}

model Voucher {
  id             String        @id @default(uuid()) @db.Uuid
  planId         String?       @map("plan_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  description    String?       @map("description") @db.VarChar(255)
  code           String?       @map("code") @db.VarChar(255)
  status         VoucherStatus @default(UNUSED)
  affiliate      String?       @map("affiliate") @db.VarChar(5)

  plan         Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([code])
  @@index([planId])
  @@index([subscriptionId])
  @@map("vouchers")
}

// ============================================================
// MODULE: ESTABLISHMENTS_CORE
// ============================================================
model Subdomain {
  id              String      @id @default(uuid()) @db.Uuid
  establishmentId String?     @map("establishment_id") @db.Uuid
  type            DomainType? @map("type")
  subdomain       String?     @map("subdomain") @db.VarChar(255)
  url             String?     @db.VarChar(255)

  @@index([establishmentId])
  @@index([subdomain])
  @@map("subdomains")
}

// ============================================================
// MODULE: CATALOG
// ============================================================
model Validity {
  id              String  @id @default(uuid()) @db.Uuid
  day             String  @default("1") @map("day") @db.VarChar(550)
  month           String? @map("month") @db.VarChar(550)
  year            String? @map("year") @db.VarChar(550)
  productId       String? @map("product_id") @db.Uuid
  establishmentId String  @map("establishment_id") @db.Uuid
  quantity        String? @default("-1") @map("quantity") @db.VarChar(550)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@index([productId])
  @@map("validities")
}
